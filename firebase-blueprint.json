{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "WardrobeItem": {
      "title": "Wardrobe Item",
      "description": "An item analyzed and saved in the wardrobe",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["person", "dress", "accessory"] },
        "imageUrl": { "type": "string" },
        "analysis": { "type": "object" },
        "style": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "imageUrl", "analysis", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/wardrobe/{itemId}": {
      "schema": "WardrobeItem",
      "description": "User wardrobe items"
    }
  }
}
